# /etc/inittab for the PythonOS live system.
#
# PythonOS is the only thing that ever runs on a console. There is deliberately NO getty and NO shell
# here: no login prompt on any console (including the other virtual terminals and the serial port).

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# PythonOS on the first console; init restarts it if it ever stops
tty1::respawn:/usr/local/bin/pythonos-session

# Ctrl+Alt+Del restarts the machine
::ctrlaltdel:/sbin/reboot

# Before shutting down or rebooting
::shutdown:/sbin/openrc shutdown
