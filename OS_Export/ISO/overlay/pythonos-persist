#!/bin/sh
# Sourced (not run) by pythonos-session. If a disk or partition labelled PYOS_DATA is plugged in, mount it and
# point PythonOS's accounts, files and settings at it, so they survive the machine being switched off.
# A disk labelled PYOS_CRYPT is an encrypted (LUKS) one: it asks for the passphrase first (three tries), then the
# unlocked disk is used the same way.
# Create such a disk from inside PythonOS with:  persist create   (or: persist create --encrypt)
#
# The disk is mounted nosuid,nodev,noexec: nothing on it can ever be run as a program by the system.
# This script never starts a shell and never fails the boot - without the disk PythonOS simply starts as usual.

PYOS_DATA_MNT=/mnt/pyos-data
PYOS_HOME=/opt/pythonos

pyos_find_label() {
    findfs LABEL="$1" 2>/dev/null || blkid -L "$1" 2>/dev/null
}

# Unlock an encrypted data disk. Prints the unlocked device on success.
pyos_unlock() {
    crypt="$1"
    command -v cryptsetup >/dev/null 2>&1 || return 1
    if [ -b /dev/mapper/pyosdata ]; then
        echo /dev/mapper/pyosdata
        return 0
    fi
    for _try in 1 2 3; do
        printf 'PythonOS data disk passphrase: ' >&2
        stty -echo 2>/dev/null
        read -r pyos_pass
        stty echo 2>/dev/null
        echo >&2
        if printf '%s' "$pyos_pass" | cryptsetup open --type luks --key-file=- "$crypt" pyosdata 2>/dev/null; then
            pyos_pass=""
            echo /dev/mapper/pyosdata
            return 0
        fi
        pyos_pass=""
        echo "That passphrase did not work." >&2
    done
    return 1
}

pyos_persist() {
    dev=""
    crypt=""
    # USB disks can take a moment to appear after power-on
    for _try in 1 2 3 4; do
        dev="$(pyos_find_label PYOS_DATA)"
        crypt="$(pyos_find_label PYOS_CRYPT)"
        { [ -n "$dev" ] || [ -n "$crypt" ]; } && break
        sleep 0.5
    done
    if [ -n "$crypt" ] && [ -b "$crypt" ]; then
        unlocked="$(pyos_unlock "$crypt")" || return 0
        dev="$unlocked"
        export PYOS_PERSIST_ENCRYPTED=1
    fi
    [ -n "$dev" ] && [ -b "$dev" ] || return 0

    mkdir -p "$PYOS_DATA_MNT"
    if ! mountpoint -q "$PYOS_DATA_MNT"; then
        mount -o nosuid,nodev,noexec "$dev" "$PYOS_DATA_MNT" 2>/dev/null || return 0
    fi
    chmod 700 "$PYOS_DATA_MNT"
    mkdir -p "$PYOS_DATA_MNT/files" "$PYOS_DATA_MNT/.OSData"

    # first use: keep the standard folder layout the image ships with
    if [ -z "$(ls -A "$PYOS_DATA_MNT/files" 2>/dev/null)" ] && [ -d "$PYOS_HOME/files" ] && [ ! -L "$PYOS_HOME/files" ]; then
        cp -a "$PYOS_HOME/files/." "$PYOS_DATA_MNT/files/" 2>/dev/null
    fi
    for name in files .OSData; do
        [ -L "$PYOS_HOME/$name" ] || rm -rf "${PYOS_HOME:?}/$name"
        [ -L "$PYOS_HOME/$name" ] || ln -s "$PYOS_DATA_MNT/$name" "$PYOS_HOME/$name"
    done
    # Bluetooth pairings and printers survive too: keep their state on the data disk and restart the services onto it
    for state in bluetooth cups; do
        src="/var/lib/$state"
        [ "$state" = cups ] && src=/etc/cups
        mkdir -p "$PYOS_DATA_MNT/$state"
        if [ -d "$src" ] && [ ! -L "$src" ]; then
            [ -z "$(ls -A "$PYOS_DATA_MNT/$state" 2>/dev/null)" ] && cp -a "$src/." "$PYOS_DATA_MNT/$state/" 2>/dev/null
            rm -rf "$src" && ln -s "$PYOS_DATA_MNT/$state" "$src"
            command -v rc-service >/dev/null 2>&1 && rc-service "$( [ "$state" = cups ] && echo cupsd || echo bluetooth )" restart >/dev/null 2>&1
        fi
    done
    export PYOS_USERS_FILE="$PYOS_DATA_MNT/users.json"
    export PYOS_PERSISTENT=1
    # an update made with updatecheck is saved on the data disk too (.OSData/core_overlay); core_overlay.py puts it back if it is newer than this image
    export PYOS_CORE_OVERLAY=1
}

pyos_persist
